# Happy self-host — copiar a packages/twenty-docker/.env
TAG=latest
SERVER_URL=http://localhost:3000
STORAGE_TYPE=local

# Facturación Twenty desactivada = sin bloqueos Stripe/trial
IS_BILLING_ENABLED=false

# Licencias Happy (sistema propio, ver HAPPY_LICENSES.md)
# Generar: node happy/scripts/happy-license.mjs generate --client "Acme" --edition pro
HAPPY_EDITION=community
# HAPPY_LICENSE_KEY=HAPPY-...
HAPPY_MAX_USERS=50
HAPPY_MAX_WORKSPACES=10
# HAPPY_LICENSE_SECRET=cambia-este-secreto-en-produccion

# Email remitente Happy
EMAIL_FROM_ADDRESS=noreply@happy.local
EMAIL_FROM_NAME=Happy CRM

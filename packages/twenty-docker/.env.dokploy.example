# Happy CRM en Dokploy (servidor happyapp, sin dominio aún)
# Copiar a ~/crm_happy/.env en el servidor y completar secretos.
TAG=latest
DOCKER_IMAGE=happy/crm_happy
SERVER_URL=http://10.20.50.102:3100
STORAGE_TYPE=local
IS_BILLING_ENABLED=false
HAPPY_EDITION=community
HAPPY_MAX_USERS=50
HAPPY_MAX_WORKSPACES=10
EMAIL_FROM_ADDRESS=noreply@happy.local
EMAIL_FROM_NAME="Happy CRM"
# Postgres/Redis externos (red crm_happy). Contraseñas solo en el servidor.
PG_DATABASE_URL=postgres://postgres:CAMBIAME@crm_happy-postgres:5432/crm_happy
REDIS_URL=redis://crm_happy-redis:6379
# Generar: openssl rand -base64 32
ENCRYPTION_KEY=CAMBIAME
APP_SECRET=CAMBIAME

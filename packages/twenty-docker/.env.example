# Happy CRM — ejemplo de entorno para Docker.
# Copiar a `.env` y generar los secretos (nunca commitear el `.env` real):
#   cp .env.example .env
#   openssl rand -base64 32   # -> ENCRYPTION_KEY
#   openssl rand -hex 32      # -> PG_DATABASE_PASSWORD (sin caracteres especiales:
#                             #    va sin codificar en PG_DATABASE_URL)
#
# Self-host (docker-compose.yml): bastan TAG, SERVER_URL, secretos, STORAGE_TYPE
# y PG_DATABASE_PASSWORD; el resto usa los defaults hacia db/redis internos.
# Dokploy (docker-compose.dokploy.yml): además PG_DATABASE_URL y REDIS_URL
# externos del Environment (el overlay los exige).
# Desarrollo (docker-compose.dev.yml): no usa este archivo (usa postgres/postgres
# fijos + código en el host vía `yarn start`).

# --- Imagen y puertos ---
TAG=latest
# Imagen que se construye desde este repo (build en docker-compose.yml).
# Para usar una prebuilt sin compilar: DOCKER_IMAGE=twentycrm/twenty + `up --no-build`.
#DOCKER_IMAGE=happy/crm_happy
# Puerto público. La doc oficial usa 3000; en Dokploy se usa 3100 porque :3000
# lo ocupa Dokploy (el overlay ya trae 3100 por defecto).
#HOST_PORT=3000

# --- Topes de memoria del build en el servidor (MB de heap Node) ---
# Defaults para host chico compartido; subir en CI/PC potente.
#FOCUS_NODE_MEM=2048
#SERVER_BUILD_MEM=3072
#FRONT_BUILD_MEM=4096

# --- Happy CRM self-host defaults: no Stripe/billing blocks ---
# Dejar en false para operar sin suscripción Twenty ni trial locks.
#IS_BILLING_ENABLED=false
# No se requiere ENTERPRISE_KEY para el CRM core.
# --- Happy licenses (sistema propio, ver happy/scripts/happy-license.mjs) ---
#HAPPY_EDITION=community
#HAPPY_LICENSE_KEY=
#HAPPY_LICENSE_SECRET=
#HAPPY_MAX_USERS=50
#HAPPY_MAX_WORKSPACES=10

# --- Postgres/Redis internos (self-host) ---
#PG_DATABASE_USER=postgres
# Use openssl rand -hex 32 for the password, it goes into PG_DATABASE_URL as is
#PG_DATABASE_PASSWORD=replace_me_with_a_strong_password_without_special_characters
#PG_DATABASE_HOST=db
#PG_DATABASE_PORT=5432
#PG_DATABASE_NAME=default
#REDIS_URL=redis://redis:6379
#REDIS_CACHE_PREFIX=

# --- Dokploy con bases externas (solo overlay .dokploy.yml) ---
#PG_DATABASE_URL=postgres://user:password@dokploy-postgres-host:5432/dbname
#REDIS_URL=redis://dokploy-redis-host:6379

SERVER_URL=http://localhost:3000
# Multiworkspace requiere un dominio base y DNS/proxy wildcard para los
# subdominios de workspace. Si se omite, el servidor usa SERVER_URL como base.
#IS_MULTIWORKSPACE_ENABLED=true
#DEFAULT_SUBDOMAIN=app
#FRONTEND_URL=https://crm.example.com

# Use openssl rand -base64 32 for each secret below
#ENCRYPTION_KEY=replace_me_with_a_random_string
#FALLBACK_ENCRYPTION_KEY= # set to the previous ENCRYPTION_KEY during a rotation
#APP_SECRET= # legacy: only required for instances that pre-date ENCRYPTION_KEY

STORAGE_TYPE=local

# STORAGE_S3_REGION=eu-west-3
# STORAGE_S3_NAME=my-bucket
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# --- Email remitente (opcional; descomentar para activar) ---
#EMAIL_FROM_ADDRESS=noreply@happy.local
#EMAIL_FROM_NAME=Happy CRM
#EMAIL_DRIVER=smtp
#EMAIL_SMTP_HOST=
#EMAIL_SMTP_PORT=
#EMAIL_SMTP_USER=
#EMAIL_SMTP_PASSWORD=
